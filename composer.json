{
    "name": "sympress/demo",
    "type": "project",
    "description": "Reference WordPress website demonstrating structured development with SymPress and Symfony components.",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-zip": "*",
        "roots/wordpress": "^7.1.1",
        "sympress/asset-compiler": "dev-main",
        "sympress/assets": "dev-main",
        "sympress/demo-base-mu-plugins": "dev-main",
        "sympress/demo-plugin": "dev-main",
        "sympress/event-dispatcher": "dev-main",
        "sympress/kernel": "^1.1",
        "sympress/migration": "dev-main",
        "sympress/monolog-bundle": "dev-main",
        "sympress/orm": "dev-main",
        "sympress/wp-cli-console": "dev-main",
        "sympress/runtime": "^1.1.1",
        "wpackagist-theme/twentytwentyfive": "^1.5.0"
    },
    "require-dev": {
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^11.5",
        "symfony/var-dumper": "^8.1",
        "sympress/coding-standards": "dev-main",
        "sympress/profiler": "dev-main",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "brain/monkey": "^2.6",
        "php-stubs/wordpress-stubs": ">=7.0"
    },
    "extra": {
        "wordpress-install-dir": "public/wp",
        "wordpress-content-dir": "public/wp-content",
        "sympress-runtime": "dev-ops/runtime.json",
        "installer-paths": {
            "public/wp-content/mu-plugins/{$name}": [
                "type:wordpress-muplugin"
            ],
            "public/wp-content/plugins/{$name}": [
                "type:wordpress-plugin"
            ],
            "public/wp-content/themes/{$name}": [
                "type:wordpress-theme"
            ]
        },
        "sympress": {
            "asset-compiler": {
                "auto-run": true,
                "execution-strategy": "grouped",
                "package-manager": "npm",
                "packages": {
                    "sympress/demo-plugin": true
                }
            },
            "starter_conventions": [
                "bin/console",
                "dev-ops/runtime.json",
                "packages/base-mu-plugins",
                "public/wp-content"
            ],
            "public_components_demonstrated": [
                "sympress/runtime",
                "sympress/kernel",
                "sympress/event-dispatcher",
                "sympress/migration",
                "sympress/assets",
                "sympress/asset-compiler",
                "sympress/wp-cli-console",
                "sympress/monolog-bundle",
                "sympress/orm",
                "sympress/profiler",
                "sympress/coding-standards"
            ]
        }
    },
    "scripts": {
        "cleanup": "rm -rf ./public/wp/wp-content",
        "build:production": [
            "Composer\\Config::disableProcessTimeout",
            "@composer compile-assets --mode production"
        ],
        "post-install-cmd": [
            "@cleanup"
        ],
        "post-update-cmd": [
            "@cleanup"
        ],
        "demo:seed": [
            "@php wp-cli.phar plugin activate sympress-demo",
            "@php wp-cli.phar sympress-demo:create-notes --set=quotes --count=18 --reset"
        ],
        "qa:validate": "composer validate --strict --no-check-publish",
        "qa:audit": "composer audit --locked --no-interaction",
        "cs": [
            "cd packages/base-mu-plugins && ../../vendor/bin/phpcs --standard=phpcs.xml.dist",
            "cd packages/sympress-demo && ../../vendor/bin/phpcs --standard=phpcs.xml.dist"
        ],
        "static-analysis": [
            "cd packages/base-mu-plugins && ../../vendor/bin/phpstan analyse -c phpstan.neon --memory-limit=1G --no-progress",
            "cd packages/sympress-demo && ../../vendor/bin/phpstan analyse -c phpstan.neon --memory-limit=1G --no-progress"
        ],
        "test": "cd packages/sympress-demo && ../../vendor/bin/phpunit -c phpunit.xml.dist --no-coverage",
        "qa": [
            "@qa:validate",
            "@qa:audit",
            "@cs",
            "@static-analysis",
            "@test",
            "@qa:runtime"
        ],
        "qa:runtime": "@php wp-cli.phar sympress-demo:runtime-smoke",
        "runtime:setup": "@php vendor/bin/runtime",
        "qa:production": "@php vendor/bin/runtime doctor --production --database-health",
        "qa:operations": "python3 -m unittest discover -s dev-ops/tests -v"
    },
    "config": {
        "classmap-authoritative": false,
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.5"
        },
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "roots/wordpress-core-installer": true,
            "phpstan/extension-installer": true,
            "sympress/asset-compiler": true,
            "sympress/runtime": true
        },
        "policy": {
            "advisories": {
                "block": true,
                "audit": "fail",
                "ignore-id": {
                    "CVE-2022-3590": "Wordfence marks every WordPress version affected and no patched release exists; keep outbound HTTP restricted and review this waiver regularly.",
                    "CVE-2017-14990": "Wordfence marks every WordPress version affected and no patched release exists; production multisite signup is disabled."
                }
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "./packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "sympress/demo-base-mu-plugins": "dev-main",
                    "sympress/demo-plugin": "dev-main"
                }
            }
        },
        {
            "type": "composer",
            "url": "https://wpackagist.org"
        },
        {
            "name": "wpsecadv",
            "type": "composer",
            "url": "https://repo-wpsecadv.typist.tech",
            "only": [
                "roots/wordpress-no-content",
                "wpackagist-plugin/*",
                "wpackagist-theme/*"
            ]
        }
    ],
    "autoload-dev": {
        "psr-4": {
            "SymPress\\Demo\\Tests\\": "packages/sympress-demo/tests/"
        }
    }
}
