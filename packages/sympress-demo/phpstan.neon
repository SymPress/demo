parameters:
    level: 6
    paths:
        - src
        - tests
        - ../site-policy
    tmpDir: var/cache/phpstan
    bootstrapFiles:
        - tests/bootstrap.php
    scanFiles:
        - phar://%currentWorkingDirectory%/../../wp-cli.phar/vendor/wp-cli/wp-cli/php/class-wp-cli.php
    treatPhpDocTypesAsCertain: false
